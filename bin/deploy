#!/usr/bin/env bash
# Publish the committed master to gh-pages, the branch GitHub Pages serves.
# Only files tracked in git are published (local leftovers are ignored).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if [ -n "$(git status --porcelain)" ]; then echo "Commit or stash your changes first."; exit 1; fi
SRC=$(git rev-parse --short HEAD)
EXPORT=$(mktemp -d); TMP=$(mktemp -d)
git archive HEAD | tar -x -C "$EXPORT"
rm -rf "$EXPORT/.github" "$EXPORT/bin" "$EXPORT/README.md" "$EXPORT/build_pages.py" "$EXPORT/.gitignore"
touch "$EXPORT/.nojekyll"
git fetch -q origin gh-pages
git branch -f gh-pages origin/gh-pages >/dev/null
git worktree add -q "$TMP" gh-pages
rsync -a --delete --exclude .git "$EXPORT"/ "$TMP"/
( cd "$TMP" && git add -A && { git commit -q -m "Deploy $SRC from master" && git push -q origin gh-pages && echo "Deployed $SRC to gh-pages."; } || echo "Nothing new to deploy." )
git worktree remove --force "$TMP"; rm -rf "$EXPORT"
